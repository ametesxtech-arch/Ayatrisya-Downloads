# Reference only. Set non-secret values in Replit Environment variables and
# credentials in Replit Secrets. Do not commit a populated .env file.

# Firebase Web app settings (public identifiers; these are bundled by Vite).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public Firebase project ID for verifying signed-in users on the API service.
FIREBASE_PROJECT_ID=

# Public client identifiers.
VITE_GOOGLE_CLIENT_ID=

# Deployed Render API Server Gateway base URL (e.g. https://<your-service>.onrender.com).
# In production, must be a secure HTTPS endpoint. Leave blank for same-origin proxy in development.
VITE_API_URL=

# Optional public desktop download URLs and release metadata (HTTPS only).
VITE_DESKTOP_DOWNLOAD_URL=
VITE_DESKTOP_DOWNLOAD_WINDOWS_URL=
VITE_DESKTOP_DOWNLOAD_WINDOWS_VERSION=
VITE_DESKTOP_DOWNLOAD_WINDOWS_SIZE_BYTES=
VITE_DESKTOP_DOWNLOAD_WINDOWS_SHA256=
VITE_DESKTOP_DOWNLOAD_WINDOWS_NOTES_URL=
VITE_DESKTOP_DOWNLOAD_LINUX_URL=
VITE_DESKTOP_DOWNLOAD_LINUX_VERSION=
VITE_DESKTOP_DOWNLOAD_LINUX_SIZE_BYTES=
VITE_DESKTOP_DOWNLOAD_LINUX_SHA256=
VITE_DESKTOP_DOWNLOAD_LINUX_NOTES_URL=
VITE_DESKTOP_DOWNLOAD_MAC_URL=
VITE_DESKTOP_DOWNLOAD_MAC_VERSION=
VITE_DESKTOP_DOWNLOAD_MAC_SIZE_BYTES=
VITE_DESKTOP_DOWNLOAD_MAC_SHA256=
VITE_DESKTOP_DOWNLOAD_MAC_NOTES_URL=

# Ayatrisya-owned model gateway configuration. The endpoint is non-secret.
AYATRISYA_MODEL_ENDPOINT=
# Store the value in Replit Secrets, not in a populated .env file.
AYATRISYA_MODEL_API_KEY=

# User-owned OAuth applications. Keep these server-side; never add the VITE_ prefix.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=

# Required HTTPS origin in production, e.g. https://your-published-domain.
AYATRISYA_APP_ORIGIN=

# Fallback AI Engine: Gemini API key for chat only (server-side only, never add VITE_ prefix)
GEMINI_API_KEY=
AYATRISYA_MODEL_PROVIDER=custom

# Cloudflare Workers AI for Cloud Image Generation ONLY (server-side only, never add VITE_ prefix)
# Primary model: @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model override (default: @cf/black-forest-labs/flux-1-schnell)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# SESSION_SECRET is managed securely on server-side. Never commit actual secret keys.
SESSION_SECRET=
