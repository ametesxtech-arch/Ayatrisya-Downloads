# Reference only. Set non-secret values in Replit Environment variables and
# credentials in Replit Secrets. Do not commit a populated .env file.

# Firebase Web app settings (public identifiers; these are bundled by Vite).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public Firebase project ID for verifying signed-in users on the API service.
FIREBASE_PROJECT_ID=

# Public client identifiers.
VITE_GOOGLE_CLIENT_ID=

# Optional public desktop download URLs (HTTPS only).
VITE_DESKTOP_DOWNLOAD_URL=
VITE_DESKTOP_DOWNLOAD_WINDOWS_URL=
VITE_DESKTOP_DOWNLOAD_MAC_URL=
VITE_DESKTOP_DOWNLOAD_LINUX_URL=

# Ayatrisya-owned model gateway configuration. The endpoint is non-secret.
AYATRISYA_MODEL_ENDPOINT=
# Store the value in Replit Secrets, not in a populated .env file.
AYATRISYA_MODEL_API_KEY=

# User-owned OAuth applications. Keep these server-side; never add the VITE_ prefix.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=

# Required HTTPS origin in production, e.g. https://your-published-domain.
AYATRISYA_APP_ORIGIN=

# SESSION_SECRET is already managed in Replit Secrets. Never copy it into this file.
