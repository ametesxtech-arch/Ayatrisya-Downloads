modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_FIREBASE_AUTH_DOMAIN = "ayatrisya.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID = "ayatrisya"
VITE_FIREBASE_APP_ID = "1:663542830691:web:70912ddce81c1ecd284a56"
FIREBASE_PROJECT_ID = "ayatrisya"
VITE_AYATRISYA_ENDPOINT = "http://127.0.0.1:8000"
AYATRISYA_MODEL_ENDPOINT = "http://127.0.0.1:8000"
VITE_FIREBASE_API_KEY = "AIzaSyAsTIhiNu7UhTwOh-gfY5exLLIX9qGRtyk"

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "atk", "at-spi2-atk", "cups", "dbus", "cairo", "gtk3", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "mesa", "libxkbcommon", "alsa-lib", "libgbm", "xorg.xorgserver", "gsettings-desktop-schemas", "hicolor-icon-theme"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 25517
externalPort = 3000
