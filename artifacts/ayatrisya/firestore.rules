rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/privateSettings/personalization {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "schemaVersion",
          "wallpaper",
          "personalization",
          "updatedAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.wallpaper is string
        && request.resource.data.wallpaper.matches("^(none|preset-([0-9]|[1-6][0-9]))$")
        && request.resource.data.personalization is map
        && request.resource.data.personalization.keys().hasOnly([
          "enabled",
          "useMemory",
          "memorySummary",
          "instructions",
          "avoid",
          "tone",
          "length",
          "format",
          "examples",
          "clarifying",
          "technicality"
        ])
        && request.resource.data.personalization.enabled is bool
        && request.resource.data.personalization.useMemory is bool
        && request.resource.data.personalization.memorySummary is string
        && request.resource.data.personalization.memorySummary.size() <= 6000
        && request.resource.data.personalization.instructions is string
        && request.resource.data.personalization.instructions.size() <= 2000
        && request.resource.data.personalization.avoid is string
        && request.resource.data.personalization.avoid.size() <= 1000
        && request.resource.data.personalization.tone in ["balanced", "friendly", "professional", "direct", "creative"]
        && request.resource.data.personalization.length in ["concise", "balanced", "detailed"]
        && request.resource.data.personalization.format in ["automatic", "paragraphs", "bullets", "steps"]
        && request.resource.data.personalization.examples in ["when-useful", "often", "rarely"]
        && request.resource.data.personalization.clarifying in ["when-needed", "assume", "ask-first"]
        && request.resource.data.personalization.technicality in ["accessible", "balanced", "technical"]
        && request.resource.data.updatedAt is string;
    }
  }
}
